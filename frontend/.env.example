# ==============================================================================
# PREP_AI FRONTEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Note: All VITE_* variables are embedded publicly into client-side JS bundles.
# NEVER put secrets, private API keys, or database credentials here!
# ==============================================================================

# API Base URL (your backend deployment URL, e.g. https://your-backend.onrender.com)
# Leave empty when running behind Nginx reverse proxy on the same domain
VITE_API_URL=

# Google OAuth Client ID (from Google Cloud Console → APIs & Services → Credentials)
VITE_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>
