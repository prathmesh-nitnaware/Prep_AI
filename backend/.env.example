# ==============================================================================
# PREP_AI BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and fill in your actual production/development credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Application & Security
PORT=5000
SECRET_KEY=<GENERATE_A_SECURE_PRODUCTION_SECRET_MIN_32_BYTES>
ENVIRONMENT=production

# Database (Neon Serverless PostgreSQL connection string with TLS)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<HOST>/<DATABASE>?sslmode=require

# AI Providers & Model Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.0-flash
GEMINI_QUESTION_MODEL=gemini-2.0-flash
GEMINI_EVALUATION_MODEL=gemini-2.0-flash
GEMINI_REPORT_MODEL=gemini-2.0-flash
MAX_AI_RETRIES=2
MAX_INTERVIEW_QUESTIONS=10
MAX_REPORT_GENERATIONS=1

# Local Ollama Fallback (if AI_PROVIDER=ollama or as offline fallback)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# Email / SMTP Configuration
EMAIL_VERIFICATION_ENABLED=False
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
MAIL_USE_TLS=True

# Frontend URL (Used for email verification and password reset links)
FRONTEND_URL=https://your-domain.com
