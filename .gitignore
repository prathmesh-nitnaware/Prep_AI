# --- .gitignore ---
# This file tells Git what to ignore in the monorepo.

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# =========================
# Dependencies
# =========================
# Node
node_modules/
frontend/node_modules/

# Python Virtual Environments
.venv/
venv/
env/
backend/.venv/
.Python

# =========================
# Python Artifacts & Cache
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
pip-log.txt
pip-delete-this-directory.txt

# =========================
# Build Outputs
# =========================
dist/
frontend/dist/
build/
.vite/

# =========================
# Database & Persistent Data
# =========================
*.db
*.sqlite
*.sqlite3
mongodb_data/

# =========================
# Logs
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# OS & IDE Files
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =========================
# Test/Sample files
# =========================
ml/audio/test_audio.wav
ml/nlp/test_resume.pdf
scratch/

# =========================
# Backend dev/debug artifacts
# =========================
backend/test_out.txt
backend/test_out_utf8.txt
backend/test_login.py
backend/update_samples.py
backend/verify_all_users.py
